# --- PROJECT DATA ---
# Large S1 imagery and processed images must not be versioned
data/
data_raw/
outputs/

# --- PYTHON & BYTES ---
# Compiled files and caches (not needed for the code to run)
__pycache__/
*.py[cod]
*$py.class
*.so

# --- JUPYTER NOTEBOOKS ---
# Even with nbstripeout, temporary checkpoints can cause git conflicts
.ipynb_checkpoints/

# --- IDE (VS CODE) ---
# Project-specific settings 
.vscode/
.history/

# --- SNAP / JVM ---
# Crash reports written by the Java VM when gpt.exe dies (out of memory...).
# They land in the current directory of the process, i.e. wherever the
# pipeline was launched from — hence no leading path.
hs_err_pid*.log

# --- SYSTEM ---
.DS_Store
Thumbs.db
